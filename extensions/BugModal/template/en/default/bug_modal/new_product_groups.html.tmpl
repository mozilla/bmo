[%#
  # product: product object
  # groups:
  #   invalid   => [{ id, name, description, checked, locked }...]
  #   mandatory => "
  #   optional  => "
  #%]

[% PROCESS group_list
    type     = "invalid"
    label    = "Groups that are not valid for the '" _ product.name _ "' product:"
    enabled  = 0
    disabled = 1
%]
[% PROCESS group_list
    type     = "mandatory"
    label    = "Mandatory '" _ product.name _ "' groups:"
    enabled  = 1
    disabled = 1
%]
[% PROCESS group_list
    type     = "optional"
    label    = "Optional '" _ product.name _ "' groups:"
    enabled  = 1
    disabled = 0
%]
<input type="hidden" name="group_verified" value="1">

[% BLOCK group_list %]
  [% RETURN UNLESS groups.$type.size %]
  [% FILTER collapse %]
    <div>
      <div>
        [% label FILTER html %]
      </div>

      [%# A locked group is one the bug is already restricted to but the user is
        # not a member of. Only members may lift an existing restriction, so the
        # checkbox is disabled and the group is left out of defined_groups,
        # which leaves the restriction in place. %]
      [% FOREACH g = groups.$type %]
        [% is_disabled = disabled || g.locked %]
        <div>
          [% IF g.checked && !g.locked %]
            <input type="hidden" name="defined_groups" value="[% g.name FILTER html %]">
          [% END %]
          <input type="checkbox" value="[% g.name FILTER html %]"
            id="group_[% g.id FILTER none %]"
            [%= IF enabled && !g.locked %]name="groups"[% END %]
            [%= "checked" IF g.checked %]
            [%= "disabled" IF is_disabled %]
            [%= 'data-mandatory="1"' IF type == "mandatory" %]>
          <label for="group_[% g.id FILTER none %]" [%= IF is_disabled %]class="group-disabled"[% END %]>
            [% g.description FILTER html %]
          </label>
        </div>
      [% END %]
    </div>
  [% END %]
[% END %]
