[% hackbot = comment.hackbot %]
[% RETURN UNLESS hackbot %]

<td rowspan="2">
  <div class="hackbot-meta">
    <span class="agent">
      <span class="icon" aria-hidden="true"></span>
      [% hackbot.agent FILTER html %]
    </span>
    [% IF hackbot.url %]
      <a class="run" href="[% hackbot.url FILTER html %]"
          target="_blank" rel="nofollow noreferrer">View Run</a>
    [% END %]
  </div>
</td>
