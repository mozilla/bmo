[% RETURN UNLESS hackbot_runs %]

[%# Hidden until hackbot_runs.js finds at least one run for the bug. %]
<div id="hackbot-runs-module" class="bz_default_hidden">
  [% WRAPPER bug_modal/module.html.tmpl
      title = "Hackbot"
      subtitle = [{ unfiltered => '<span class="hackbot-run-count"></span>' }]
      collapsed = 0
  %]
    [% INCLUDE hackbot/table.html.tmpl %]
  [% END %]
</div>
